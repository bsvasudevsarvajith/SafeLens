rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // User documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Admin documents
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Cameras (Authorized CCTV management)
    // Non-admin users can read camera locations & status, but sensitive fields like streamUrl/credentials are withheld server-side
    match /cameras/{cameraId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regions (Karur, Kulithalai, etc)
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Time-series crowd measurements
    match /crowdMeasurements/{measurementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Crowd AI Analyses (Video & Image records)
    match /crowdAnalyses/{analysisId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Safety Reports
    match /safetyReports/{reportId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Saved Locations
    match /savedLocations/{savedId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Trips
    match /trips/{tripId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Videos metadata
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Legacy video_analysis and routes
    match /video_analysis/{analysisId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /safety_scores/{scoreId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
